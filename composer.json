{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "shipfastlabs/grant",
    "description": "Minimal enum-first roles and permissions for Laravel.",
    "keywords": [
        "laravel",
        "authorization",
        "roles",
        "permissions",
        "gate",
        "enum",
        "acl"
    ],
    "homepage": "https://github.com/shipfastlabs/grant",
    "license": "MIT",
    "authors": [
        {
            "name": "Pushpak Chhajed",
            "email": "hello@shipfastlabs.com"
        }
    ],
    "require": {
        "php": "^8.4",
        "doctrine/dbal": "^4.0",
        "doctrine/orm": "^3.7",
        "illuminate/auth": "^13.0",
        "illuminate/console": "^13.0",
        "illuminate/support": "^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.9",
        "laravel/pao": "^1.0",
        "laravel/pint": "^1.29",
        "orchestra/testbench": "^10.0||^11.0",
        "pestphp/pest": "^4.6||^5.0",
        "pestphp/pest-plugin-laravel": "^4.1||^5.0",
        "pestphp/pest-plugin-type-coverage": "^4.0||^5.0",
        "phpstan/extension-installer": "^1.4",
        "rector/rector": "^2.4.2"
    },
    "autoload": {
        "psr-4": {
            "Shipfastlabs\\Grant\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Shipfastlabs\\Grant\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/",
            "Workbench\\Database\\Factories\\": "workbench/database/factories/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "@clear",
            "@prepare"
        ],
        "prepare": [
            "@php vendor/bin/testbench package:discover --ansi"
        ],
        "build": [
            "@php vendor/bin/testbench workbench:build --ansi"
        ],
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@build",
            "@php vendor/bin/testbench serve --ansi"
        ],
        "clear": [
            "@php vendor/bin/testbench package:purge-skeleton --ansi"
        ],
        "lint": [
            "pint --parallel",
            "rector"
        ],
        "test:lint": [
            "pint --parallel --test",
            "rector --dry-run"
        ],
        "test:types": [
            "phpstan --memory-limit=1G"
        ],
        "test:type-coverage": [
            "@php -d memory_limit=1G vendor/bin/pest --type-coverage --min=100"
        ],
        "test:unit": [
            "pest --parallel"
        ],
        "test:refactor": [
            "rector --dry-run"
        ],
        "test": [
            "@test:lint",
            "@test:types",
            "@test:type-coverage",
            "@test:unit"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "Shipfastlabs\\Grant\\GrantServiceProvider"
            ],
            "aliases": {
                "Grant": "Shipfastlabs\\Grant\\Facades\\Grant"
            }
        }
    },
    "config": {
        "sort-packages": true,
        "preferred-install": "dist",
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}

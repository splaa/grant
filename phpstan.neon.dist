parameters:
    level: max
    paths:
        - src
        - database
        - tests/Fixtures
        - tests/TestCase.php
    tmpDir: build/phpstan

    reportUnmatchedIgnoredErrors: true

    ignoreErrors:
        # Doctrine assigns generated identifiers through reflection.
        -
            identifier: property.unusedType
            paths:
                - src/Entities
                - tests/Fixtures

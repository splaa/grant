#!/usr/bin/env bash
set -euo pipefail

step() {
    printf '\n==> %s\n' "$1"
    shift
    time "$@"
}

php_is_ready() {
    command -v php >/dev/null \
        && php -r 'exit(version_compare(PHP_VERSION, "8.4", ">=") ? 0 : 1);' \
        && php -r 'foreach (["bcmath", "curl", "dom", "fileinfo", "intl", "libxml", "mbstring", "pdo_sqlite", "sqlite3", "zip"] as $extension) { if (! extension_loaded($extension)) exit(1); }'
}

if ! php_is_ready || ! command -v composer >/dev/null; then
    if [[ "$(uname -s)" != "Linux" ]] || ! command -v apt-get >/dev/null; then
        printf 'PHP 8.4+ with the required extensions and Composer must be installed.\n' >&2
        exit 1
    fi

    export DEBIAN_FRONTEND=noninteractive
    apt=(apt-get)
    if [[ $EUID -ne 0 ]]; then
        apt=(sudo apt-get)
    fi

    step "Update package metadata" "${apt[@]}" update
    step "Install package repository prerequisites" "${apt[@]}" install -y ca-certificates curl

    keyring_deb="$(mktemp)"
    trap 'rm -f "$keyring_deb"' EXIT
    curl -fsSL https://packages.sury.org/debsuryorg-archive-keyring.deb -o "$keyring_deb"
    if [[ $EUID -eq 0 ]]; then
        dpkg -i "$keyring_deb"
        printf 'deb [signed-by=/usr/share/keyrings/debsuryorg-archive-keyring.gpg] https://packages.sury.org/php/ bookworm main\n' > /etc/apt/sources.list.d/php.list
    else
        sudo dpkg -i "$keyring_deb"
        printf 'deb [signed-by=/usr/share/keyrings/debsuryorg-archive-keyring.gpg] https://packages.sury.org/php/ bookworm main\n' \
            | sudo tee /etc/apt/sources.list.d/php.list >/dev/null
    fi

    step "Refresh PHP package metadata" "${apt[@]}" update
    step "Install PHP and Composer" "${apt[@]}" install -y \
        composer \
        php8.4-bcmath \
        php8.4-cli \
        php8.4-curl \
        php8.4-intl \
        php8.4-mbstring \
        php8.4-sqlite3 \
        php8.4-xml \
        php8.4-zip \
        unzip
fi

php_is_ready || {
    printf 'Installed PHP does not satisfy PHP 8.4+ and the required extensions.\n' >&2
    exit 1
}

step "Install Composer dependencies" composer update \
    --no-interaction \
    --no-progress \
    --no-scripts \
    --prefer-dist

step "Prepare the Testbench workbench" composer run prepare
